                document.body.style.backgroundImage = '';
            }
            const cursorUrl = appearance.cursor === 'custom' ? appearance.cursorCustom : (appearance.cursor === 'default' ? '' : appearance.cursor);
            if (cursorUrl) {
                document.body.style.cursor = `url('${cursorUrl}'), auto`;
            } else {
                document.body.style.cursor = '';
            }
            setupOverlay();
        }

        // Simple falling overlay using CSS animation and random clones
        function setupOverlay() {
            const old = document.getElementById('falling-overlay');
            if (old) old.remove();
            if (appearance.overlayOn !== 'on' || !appearance.overlaySprite) return;
            const overlay = document.createElement('div');
            overlay.id = 'falling-overlay';
            overlay.style.position = 'fixed';
            overlay.style.left = '0'; overlay.style.top = '0'; overlay.style.right = '0'; overlay.style.bottom = '0';
            overlay.style.pointerEvents = 'none';
            document.body.appendChild(overlay);
            for (let i=0;i<12;i++) {
                const img = document.createElement('img');
                img.src = appearance.overlaySprite;
                const size = 24 + Math.floor(Math.random()*32);
                img.style.width = size+'px'; img.style.height = 'auto';
                img.style.position = 'absolute';
                img.style.left = Math.floor(Math.random()*100)+'%';
                img.style.top = '-60px';
                img.style.animation = `fall${i} ${6+Math.random()*8}s linear infinite`;
                overlay.appendChild(img);
                const style = document.createElement('style');
                style.textContent = `@keyframes fall${i}{0%{transform:translateY(-60px) rotate(0deg);}100%{transform:translateY(120vh) rotate(360deg);}}`;
                document.head.appendChild(style);
            }
        }

